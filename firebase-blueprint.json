{
  "entities": {
    "submission": {
      "title": "QuizSubmission",
      "description": "Hasil kuis pembelajaran siswa yang tersinkronisasi lintas perangkat",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik dokumen kuis siswa",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "Nama lengkap peserta didik",
          "maxLength": 120,
          "minLength": 1
        },
        "studentClass": {
          "type": "string",
          "description": "Kelas peserta didik (e.g. 7A, 7B, dll)",
          "maxLength": 30,
          "minLength": 1
        },
        "studentNumber": {
          "type": "string",
          "description": "Nomor absen peserta didik",
          "maxLength": 15,
          "minLength": 1
        },
        "score": {
          "type": "number",
          "description": "Nilai akhir kuis (0 - 100)"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Total soal pada kuis"
        },
        "correctCount": {
          "type": "number",
          "description": "Jumlah jawaban yang benar"
        },
        "wrongCount": {
          "type": "number",
          "description": "Jumlah jawaban yang salah"
        },
        "answers": {
          "type": "object",
          "description": "Peta jawaban siswa per nomor butir soal"
        },
        "timeSpentSeconds": {
          "type": "number",
          "description": "Total durasi pengerjaan kuis dalam detik"
        },
        "submittedAt": {
          "type": "string",
          "description": "Stempel waktu pengiriman kuis format ISO"
        },
        "violationsCount": {
          "type": "number",
          "description": "Jumlah pelanggaran keluar tab kuis yang tercatat"
        }
      },
      "required": [
        "id",
        "studentName",
        "studentClass",
        "studentNumber",
        "score",
        "totalQuestions",
        "correctCount",
        "wrongCount",
        "answers",
        "timeSpentSeconds",
        "submittedAt"
      ]
    },
    "deletedSubmission": {
      "title": "DeletedSubmission",
      "description": "Pencatatan ID data siswa yang telah dihapus permanen agar tidak muncul lagi di perangkat lain",
      "type": "object",
      "properties": {
        "deletedId": {
          "type": "string",
          "description": "ID data siswa yang dihapus secara permanen"
        },
        "deletedAt": {
          "type": "string",
          "description": "Waktu penghapusan"
        }
      },
      "required": ["deletedId", "deletedAt"]
    },
    "appSettings": {
      "title": "AppSettings",
      "description": "Pengaturan bersama aplikasi kuis termasuk PIN guru dan sinkronisasi bank soal",
      "type": "object",
      "properties": {
        "teacherPin": {
          "type": "string",
          "description": "Kode PIN akses ruang guru",
          "maxLength": 20,
          "minLength": 4
        },
        "questionsJson": {
          "type": "string",
          "description": "Kumpulan butir soal format JSON yang tersinkronisasi lintas perangkat guru dan siswa"
        },
        "totalQuestions": {
          "type": "number",
          "description": "Jumlah butir soal aktif"
        },
        "procedureTextJson": {
          "type": "string",
          "description": "Koleksi modul materi dan teks prosedur format JSON tersinkronisasi lintas perangkat"
        },
        "totalTexts": {
          "type": "number",
          "description": "Jumlah teks prosedur aktif"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan pengaturan terakhir"
        }
      }
    },
    "violation": {
      "title": "QuizViolationRecord",
      "description": "Pencatatan notifikasi pelanggaran siswa saat mengerjakan kuis untuk guru",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik pelanggaran",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "Nama siswa pelanggar",
          "maxLength": 120,
          "minLength": 1
        },
        "studentClass": {
          "type": "string",
          "description": "Kelas siswa",
          "maxLength": 30,
          "minLength": 1
        },
        "studentNumber": {
          "type": "string",
          "description": "Nomor absen siswa",
          "maxLength": 15,
          "minLength": 1
        },
        "questionNumber": {
          "type": "number",
          "description": "Nomor soal saat pelanggaran terjadi"
        },
        "violationCount": {
          "type": "number",
          "description": "Jumlah pelanggaran yang dilakukan"
        },
        "timestamp": {
          "type": "string",
          "description": "Waktu terjadinya pelanggaran format ISO"
        },
        "unlockToken": {
          "type": "string",
          "description": "Token opsional (tidak digunakan lagi)",
          "maxLength": 30
        },
        "reason": {
          "type": "string",
          "description": "Keterangan aktivitas pelanggaran siswa",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "description": "Status notifikasi pelanggaran (locked = belum dicek, unlocked = sudah dicek)",
          "enum": ["locked", "unlocked"]
        },
        "unlockedAt": {
          "type": "string",
          "description": "Waktu notifikasi ditandai sudah dicek oleh guru"
        }
      },
      "required": [
        "id",
        "studentName",
        "studentClass",
        "studentNumber",
        "questionNumber",
        "violationCount",
        "timestamp",
        "status"
      ]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "submission",
      "description": "Koleksi hasil kuis dan data siswa yang tersimpan di cloud database agar dapat dibuka dan dipantau dari perangkat lain"
    },
    "/deletedSubmissions/{submissionId}": {
      "schema": "deletedSubmission",
      "description": "Catatan penghapusan permanen agar data tidak di-restore di perangkat lain"
    },
    "/settings/{settingId}": {
      "schema": "appSettings",
      "description": "Dokumen pengaturan aplikasi seperti PIN guru yang tersinkronisasi lintas perangkat"
    },
    "/violations/{violationId}": {
      "schema": "violation",
      "description": "Koleksi log dan notifikasi pelanggaran siswa saat kuis berlangsung yang dipantau guru secara real-time"
    }
  }
}
